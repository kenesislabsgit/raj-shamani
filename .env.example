# Active caption reader: OpenAI answers and checks, Supermemory retrieval.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
SUPERMEMORY_API_KEY=
# Public AWS app: Google sign-in for new and returning users.
PUBLIC_AUTH_MODE=google
# Google OAuth Web application; secret stays on the backend.
# Authorized redirect URI: https://YOUR_SITE_HOST/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Vercel frontend. Both values must be configured together.
FRONTEND_ORIGIN=
FRONTEND_PROXY_SECRET=

# Optional local deployment credentials. Keep real values in ignored .env only.
# Leave blank to use your configured AWS profile or other SDK credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
