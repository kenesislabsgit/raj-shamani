{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node deployment/build-vercel.mjs",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(api/.*|auth/.*|sign-in|sign-up|signed-out|health/(?:live|ready)|)",
      "dest": "https://d34tjhbhxxm88k.cloudfront.net/$1",
      "headers": {
        "Cache-Control": "no-store",
        "CDN-Cache-Control": "no-store",
        "Vercel-CDN-Cache-Control": "no-store"
      },
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {"key": "x-reader-proxy-secret"},
          "args": "$FRONTEND_PROXY_SECRET",
          "env": ["FRONTEND_PROXY_SECRET"]
        }
      ]
    },
    {"src": "/index.html", "status": 307, "headers": {"Location": "/"}},
    {"src": "/sign-in.html", "status": 307, "headers": {"Location": "/sign-in"}}
  ]
}
